{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "./src",
    "declarationDir": "./lib",
    "outDir": "./lib",
    "stripInternal": true
  },
  "include": [
    "src/env.d.ts",
    "src/index.ts",
    "src/types.ts",
    "src/core/**/*.ts",
    "src/components/**/*.vue"
  ]
}
